APP_MODE=demo
PUBLIC_APP_URL=http://127.0.0.1:3000
# Empty uses disk-backed embedded PostgreSQL (PGlite) in .local/demo-db.
# Recommended: PostgreSQL in Docker (`npm run db:up`), matching production:
# DATABASE_URL=postgres://fastlife:fastlife-dev@127.0.0.1:5440/fastlife
DATABASE_URL=
LOCAL_DATABASE_PATH=.local/demo-db
LIVE_CHECKOUT_ENABLED=false
# disabled | simulated (local only: a fake payment page in this app) | paystack (test keys only)
PAYMENT_PROVIDER=disabled
PAYSTACK_SECRET_KEY=
PLANNER_PROVIDER=deterministic
# Confirmation emails: outbox (writes .local/outbox, default in development) | resend | disabled (default in production)
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
# Optional: local demo generates a random persistent secret in .local/auth-secret.
AUTH_SECRET=
# Kemi AI companion (services/kemi). Off unless exactly "true".
KEMI_ENABLED=false
KEMI_URL=http://127.0.0.1:4100
# No live provider secrets or approved commercial configuration supplied.
