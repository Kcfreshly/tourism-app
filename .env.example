APP_MODE=demo
PUBLIC_APP_URL=http://127.0.0.1:3000
# Empty uses disk-backed embedded PostgreSQL in .local/demo-db.
DATABASE_URL=
LOCAL_DATABASE_PATH=.local/demo-db
LIVE_CHECKOUT_ENABLED=false
PAYMENT_PROVIDER=disabled
PLANNER_PROVIDER=deterministic
# Optional: local demo generates a random persistent secret in .local/auth-secret.
AUTH_SECRET=
# No live provider secrets or approved commercial configuration supplied.
