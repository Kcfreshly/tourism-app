# Copy to .env (loaded by `npm run dev` / `npm start`).
NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info

# Model providers used by the profiles in src/config.ts.
ANTHROPIC_API_KEY=
# Optional per-profile override, "<provider>:<model id>":
# MODEL_KEMI_CHAT=anthropic:claude-opus-5-5

# Your self-hosted Langfuse. Leave all three empty to run untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
