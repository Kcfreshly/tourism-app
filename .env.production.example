# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Public address travellers use (sign-in and origin checks depend on it).
PUBLIC_APP_URL=https://fastlife.example.com
# Session signing secret: generate once and keep it (openssl rand -base64 48).
# Changing it signs everyone out.
AUTH_SECRET=

POSTGRES_USER=fastlife
POSTGRES_PASSWORD=
POSTGRES_DB=fastlife

# Port on the host the web app is published on (put a TLS proxy in front).
WEB_PORT=3000
# true loads the fictional demo catalogue during migrate (safe to repeat).
SEED_DEMO=true

# Kemi (start with --profile kemi and set KEMI_ENABLED=true).
KEMI_ENABLED=false
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
